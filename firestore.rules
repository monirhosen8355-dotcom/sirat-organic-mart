rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasValidProductType() {
      return !('type' in request.resource.data) ||
        request.resource.data.type == 'normal' ||
        (
          request.resource.data.type == 'affiliate' &&
          'affiliateUrl' in request.resource.data &&
          request.resource.data.affiliateUrl is string &&
          request.resource.data.affiliateUrl.matches('^https?://[^\\s]+$')
        );
    }

    // ---------- admins (allow-list, admin-only readable, never client-writable) ----------
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // only set manually via Firebase Console
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ---------- products (public read, admin write) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidProductType();
    }

    // ---------- categories (public read, admin write) ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      // guest orders have no userId (or null); logged-in customer orders store the uid
      // মূল্য প্রতিটা আইটেমের বিপরীতে products কালেকশনের সাথে মিলিয়ে যাচাই করা হয় না
      // (সেটার জন্য Cloud Function লাগবে) — কিন্তু সবচেয়ে সহজে-শোষণযোগ্য ফাঁকগুলো
      // (ভুয়া status, ঋণাত্মক ছাড়, ভুল টোটাল) এখানে আটকানো হচ্ছে।
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentMethod == 'cod' &&
        request.resource.data.discount >= 0 &&
        request.resource.data.subtotal > 0 &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total ==
          request.resource.data.subtotal +
          request.resource.data.deliveryCharge -
          request.resource.data.discount;
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        !('userId' in resource.data);
      // customers can NEVER update/delete an order — only admin (status changes etc.)
      allow update: if isAdmin();
      allow delete: if false;

      match /statusHistory/{historyId} {
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ---------- reviews (public read, signed-in create, admin moderate) ----------
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.approved == false &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- coupons (active কুপন public read, validation client-side calculateCouponValidation দিয়ে হয়; inactive/expired কুপন শুধু admin পড়তে পারবে) ----------
    match /coupons/{couponId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- brands (public read active brands, admin write) ----------
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- homeBanners (public read active banners, admin write) ----------
    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ---------- siteSettings (admin write, optional public read for non-sensitive config) ----------
    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- legalPages (public read, admin write) ----------
    match /legalPages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- support FAQs (public read, admin write) ----------
    match /supportFAQs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- customer support conversations ----------
    // Each customer has one conversation document whose ID is their auth UID.
    match /supportConversations/{conversationId} {
      allow read: if isAdmin() ||
        (isSignedIn() &&
          conversationId == request.auth.uid &&
          (!exists(/databases/$(database)/documents/supportConversations/$(conversationId)) ||
            resource.data.customerId == request.auth.uid));
      allow create: if isSignedIn() &&
        conversationId == request.auth.uid &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'updatedAt',
          'unreadForAdmin',
          'unreadForCustomer'
        ]) &&
        request.resource.data.unreadForCustomer == false
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/supportConversations/$(conversationId)).data.customerId == request.auth.uid
        );
        allow create: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/supportConversations/$(conversationId)).data.customerId == request.auth.uid &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRole == 'customer'
        );
        allow update, delete: if isAdmin();
      }
    }

    // ---------- default deny for anything not explicitly listed ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}